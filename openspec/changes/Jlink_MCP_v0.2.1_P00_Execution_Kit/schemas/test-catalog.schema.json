{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/jlink-mcp/schemas/test-catalog.schema.json",
  "title": "Jlink_MCP planned test catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "specVersion",
    "generatedAt",
    "tests"
  ],
  "properties": {
    "schemaVersion": {
      "const": "jlink-mcp.test-catalog/v1"
    },
    "specVersion": {
      "const": "0.2.1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "level",
          "description",
          "status",
          "evidence",
          "requirementId",
          "ownerPhase"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "static",
              "unit",
              "contract",
              "integration",
              "hardware"
            ]
          },
          "level": {
            "enum": [
              "affected",
              "task",
              "module",
              "phase",
              "release"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "planned",
              "implemented",
              "passed",
              "failed",
              "skipped",
              "blocked"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requirementId": {
            "type": "string",
            "pattern": "^REQ-[A-Z0-9]+-[0-9]{3}$"
          },
          "ownerPhase": {
            "type": "string",
            "pattern": "^P[0-9]{2}$"
          }
        }
      }
    }
  }
}
